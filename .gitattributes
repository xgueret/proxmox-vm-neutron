# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.md text diff=markdown
*.txt text
*.yml text
*.yaml text
*.tf text
*.py text diff=python
*.sh text eol=lf
*.json text

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Ansible vault files - treat as binary to avoid diff issues
**/vault/*.yml binary linguist-language=YAML

# Terraform lock files
.terraform.lock.hcl linguist-generated
